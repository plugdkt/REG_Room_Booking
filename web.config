<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <!-- ไม่ให้เข้าถึงโค้ดภายใน ไฟล์ตั้งค่า และไฟล์ PDF โดยตรง (PDF ต้องผ่าน print_booking_pdf.php) -->
        <hiddenSegments>
          <add segment="inc" />
          <add segment="sql" />
          <add segment="forms" />
          <add segment="tools" />
          <add segment="uploads" />
          <add segment="config.php" />
          <add segment="config.sample.php" />
          <add segment="DMS_Connect.md" />
          <add segment="README.md" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".docx" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
